generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUM
//////////////////////////////////////////////////////

enum UserRole {
  ADMIN
  STAFF
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OFFLINE
  DISABLED
}

enum TransactionStatus {
  PENDING
  PAID
  CANCEL
  CLOSE
}

enum FnbCategory {
  FOOD
  DRINK
  SNACK
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderStatus {
  DRAFT
  SEND
  CANCELLED
}

enum TypeTrackStock {
  IN // stok masuk (pembelian, restock, retur masuk)
  OUT // stok keluar (penjualan, pemakaian, retur keluar)
}

//////////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////////

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique @db.VarChar(50)
  password String
  role     UserRole @default(STAFF)

  deleted Boolean @default(false)

  payment       Payment[]
  fnbTrackStock FnbTrackStock[]
}

model Setting {
  id             Int     @id @default(autoincrement())
  isActive       Boolean @unique @default(true)
  taxPercent     Decimal @default(10.00) @db.Decimal(5, 2) // %
  servicePercent Decimal @default(5.00) @db.Decimal(5, 2) // %
}

model Room {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  capacity   Int        @default(0)
  type       String     @default("medium")
  hourlyRate Decimal    @default(0) @db.Decimal(12, 2)
  status     RoomStatus @default(AVAILABLE)

  session Session[]
}

model Customer {
  id    Int     @id @default(autoincrement())
  name  String
  phone String?

  session Session[]
}

model Session {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  startTime DateTime
  endTime   DateTime
  closed    Boolean  @default(false)

  durationMinute Int
  extraMinute    Int @default(0)
  freeMinute     Int @default(0)

  deleted Boolean @default(false)

  userId  Int
  userOut Int?

  createdAt   DateTime      @default(now())
  transaction Transaction[]

  @@index([customerId])
  @@index([roomId])
  @@index([createdAt])
}

model Transaction {
  id String @id @default(uuid()) // inv number

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id])

  roomTotal      Decimal @db.Decimal(12, 2)
  roomDiscount   Decimal @default(0) @db.Decimal(12, 2)
  fnbTotal       Decimal @default(0) @db.Decimal(12, 2)
  companionTotal Decimal @default(0) @db.Decimal(12, 2)
  subTotal       Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  service        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)

  note String?

  fnbOrder FnbOrder[]
  payment  Payment[]

  companionOrder CompanionOrder[]
}

model Payment {
  id     Int           @id @default(autoincrement())
  method PaymentMethod @default(CASH)
  status PaymentStatus @default(PENDING)
  amount Decimal       @default(0) @db.Decimal(12, 2)
  change Decimal       @default(0) @db.Decimal(12, 2)

  paidAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  note String?

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Fnb {
  id       Int         @id @default(autoincrement())
  name     String      @unique
  category FnbCategory @default(OTHER)

  trackStock Boolean @default(true)
  stock      Int     @default(0)

  price Decimal @default(0) @db.Decimal(12, 2)

  deleted Boolean @default(false)

  fnbTrackStock FnbTrackStock[]
  fnbItem       FnbItem[]
}

model FnbTrackStock {
  id       String         @id @default(uuid()) // nomor faktur dari supplier
  suplayer String
  fnbId    Int
  fnb      Fnb            @relation(fields: [fnbId], references: [id])
  userId   Int
  user     User           @relation(fields: [userId], references: [id])
  type     TypeTrackStock
  qty      Int

  createdAt DateTime @default(now())
}

model FnbOrder {
  id            String      @id @default(uuid()) // inv number
  status        OrderStatus @default(DRAFT)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  itemId        Int
  item          FnbItem     @relation(fields: [itemId], references: [id])

  total Decimal @default(0) @db.Decimal(12, 2)

  note String?

  draftAt  DateTime  @default(now())
  sendAt   DateTime?
  cancelAt DateTime?
}

model FnbItem {
  id       Int        @id @default(autoincrement())
  fnbId    Int
  fnb      Fnb        @relation(fields: [fnbId], references: [id])
  fnbOrder FnbOrder[]

  qty      Int
  // snapshot
  name     String
  price    Decimal     @default(0) @db.Decimal(12, 2)
  category FnbCategory @default(OTHER)
}

model Companion {
  id         Int     @id @default(autoincrement())
  name       String
  hourlyRate Decimal @default(0) @db.Decimal(12, 2)
  available  Boolean @default(true)

  companionOrder CompanionOrder[]
}

model CompanionOrder {
  id          String    @id @default(uuid())
  companionId Int
  companion   Companion @relation(fields: [companionId], references: [id])

  durationMinute Int
  startTime      DateTime
  endTime        DateTime
  total          Decimal   @default(0) @db.Decimal(12, 2)
  finisedAt      DateTime?
  canceldAt      DateTime?
  createdAt      DateTime  @default(now())

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}
